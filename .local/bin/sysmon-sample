#!/bin/sh
# Emits one JSON line of system metrics per interval, for the quickshell sysmon panel.
# Usage: sysmon-sample [--once] [-i SECONDS]

set -u

INTERVAL=2
ONCE=0

while [ $# -gt 0 ]; do
	case $1 in
		--once) ONCE=1 ;;
		-i) shift; INTERVAL=${1:-2} ;;
		-h|--help) sed -n '2,3p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "sysmon-sample: unknown argument: $1" >&2; exit 2 ;;
	esac
	shift
done

rd() { [ -r "$1" ] || return 1; read -r _rd < "$1" || return 1; printf '%s' "$_rd"; }

# hwmon indices are not stable across boots, so every sensor is resolved by name and label.
hwmon_by_name() {
	for _h in /sys/class/hwmon/hwmon*; do
		[ -r "$_h/name" ] || continue
		read -r _n < "$_h/name"
		[ "$_n" = "$1" ] && { printf '%s' "$_h"; return 0; }
	done
	return 1
}

hwmons_by_name() {
	_out=
	for _h in /sys/class/hwmon/hwmon*; do
		[ -r "$_h/name" ] || continue
		read -r _n < "$_h/name"
		[ "$_n" = "$1" ] && _out="$_out $_h"
	done
	[ -n "$_out" ] || return 1
	printf '%s' "${_out# }"
}

temp_by_label() {
	for _l in "$1"/temp*_label; do
		[ -r "$_l" ] || continue
		read -r _v < "$_l"
		[ "$_v" = "$2" ] && { printf '%s' "${_l%_label}_input"; return 0; }
	done
	return 1
}

# Tenths of a unit as a decimal, so the shell never needs float arithmetic.
dec1() {
	if [ "$1" -lt 0 ]; then printf '%d.%d' $(( $1 / 10 )) $(( - $1 % 10 ))
	else printf '%d.%d' $(( $1 / 10 )) $(( $1 % 10 ))
	fi
}

# Centiseconds since boot; the fraction has its leading zero stripped to dodge octal parsing.
now_cs() {
	read -r _up _ < /proc/uptime
	_f=${_up#*.}
	_f=${_f#0}
	[ -n "$_f" ] || _f=0
	printf '%d' $(( ${_up%.*} * 100 + _f ))
}

CPU_TCTL=
CPU_TCCD=
MB_VRM=
MB_CHIP=
MB_BOARD=
MB_FAN=
NVME_TEMPS=

if h=$(hwmon_by_name k10temp); then
	CPU_TCTL=$(temp_by_label "$h" Tctl) || CPU_TCTL=
	CPU_TCCD=$(temp_by_label "$h" Tccd1) || CPU_TCCD=
fi

if h=$(hwmon_by_name asusec); then
	MB_VRM=$(temp_by_label "$h" VRM) || MB_VRM=
	MB_CHIP=$(temp_by_label "$h" Chipset) || MB_CHIP=
	MB_BOARD=$(temp_by_label "$h" Motherboard) || MB_BOARD=
	[ -r "$h/fan1_input" ] && MB_FAN="$h/fan1_input"
fi

if hs=$(hwmons_by_name nvme); then
	for h in $hs; do
		if t=$(temp_by_label "$h" Composite); then NVME_TEMPS="$NVME_TEMPS $t"; fi
	done
	NVME_TEMPS=${NVME_TEMPS# }
fi

RAPL=
RAPL_MAX=0
for p in /sys/class/powercap/intel-rapl:*; do
	[ -r "$p/name" ] || continue
	read -r n < "$p/name"
	case $n in
		package-*)
			if [ -r "$p/energy_uj" ]; then
				RAPL="$p/energy_uj"
				RAPL_MAX=$(rd "$p/max_energy_range_uj") || RAPL_MAX=0
				break
			fi
			;;
	esac
done

# Emits a temperature field, or null when the sensor is absent or unreadable.
emit_temp() {
	if [ -n "$2" ] && _v=$(rd "$2"); then printf '"%s":%s,' "$1" "$(dec1 $(( _v / 100 )))"
	else printf '"%s":null,' "$1"
	fi
}

p_total=0; p_idle=0; p_rx=0; p_tx=0; p_rd=0; p_wr=0; p_energy=-1; p_cs=0
first=1

while :; do
	cs=$(now_cs)
	d_cs=$(( cs - p_cs ))
	[ "$d_cs" -gt 0 ] || d_cs=1

	read -r _ cu cn csys cidle ciow cirq csirq cst _ < /proc/stat
	total=$(( cu + cn + csys + cidle + ciow + cirq + csirq + cst ))
	idle=$(( cidle + ciow ))
	d_total=$(( total - p_total ))
	d_idle=$(( idle - p_idle ))
	[ "$d_total" -gt 0 ] || d_total=1
	cpu10=$(( (d_total - d_idle) * 1000 / d_total ))
	p_total=$total; p_idle=$idle

	mem_total=0; mem_avail=0
	while read -r k v _; do
		case $k in
			MemTotal:) mem_total=$v ;;
			MemAvailable:) mem_avail=$v; break ;;
		esac
	done < /proc/meminfo
	[ "$mem_total" -gt 0 ] || mem_total=1
	mem10=$(( (mem_total - mem_avail) * 1000 / mem_total ))

	rx=0; tx=0
	while read -r line; do
		case $line in *:*) ;; *) continue ;; esac
		set -- ${line%%:*}
		[ $# -ge 1 ] || continue
		[ "$1" = lo ] && continue
		set -- ${line#*:}
		[ $# -ge 9 ] || continue
		rx=$(( rx + $1 )); tx=$(( tx + $9 ))
	done < /proc/net/dev
	d_rx=$(( rx - p_rx )); d_tx=$(( tx - p_tx ))
	[ "$d_rx" -ge 0 ] || d_rx=0
	[ "$d_tx" -ge 0 ] || d_tx=0
	p_rx=$rx; p_tx=$tx

	sec_rd=0; sec_wr=0
	while read -r _ _ dev _ _ rs _ _ _ ws _; do
		case $dev in
			nvme*n[0-9]|sd[a-z]) sec_rd=$(( sec_rd + rs )); sec_wr=$(( sec_wr + ws )) ;;
		esac
	done < /proc/diskstats
	d_rd=$(( sec_rd - p_rd )); d_wr=$(( sec_wr - p_wr ))
	[ "$d_rd" -ge 0 ] || d_rd=0
	[ "$d_wr" -ge 0 ] || d_wr=0
	p_rd=$sec_rd; p_wr=$sec_wr

	psi_cpu=0; psi_io=0; psi_mem=0
	if [ -r /proc/pressure/cpu ]; then read -r _ a10 _ < /proc/pressure/cpu; psi_cpu=${a10#avg10=}; fi
	if [ -r /proc/pressure/io ]; then read -r _ a10 _ < /proc/pressure/io; psi_io=${a10#avg10=}; fi
	if [ -r /proc/pressure/memory ]; then read -r _ a10 _ < /proc/pressure/memory; psi_mem=${a10#avg10=}; fi

	# RAPL is a wrapping microjoule counter; a negative delta means it rolled over.
	cpu_w=null
	if [ -n "$RAPL" ] && e=$(rd "$RAPL"); then
		if [ "$p_energy" -ge 0 ]; then
			d_e=$(( e - p_energy ))
			[ "$d_e" -lt 0 ] && d_e=$(( d_e + RAPL_MAX ))
			cpu_w=$(dec1 $(( d_e / d_cs / 1000 )))
		fi
		p_energy=$e
	fi

	# The first pass only primes the counters; every delta would otherwise be measured against zero.
	if [ "$first" = 1 ]; then
		first=0
		p_cs=$cs
		if [ "$ONCE" = 1 ]; then sleep 0.25; else sleep "$INTERVAL"; fi
		continue
	fi
	p_cs=$cs

	printf '{'
	printf '"cs":%s,"dt":%s,' "$cs" "$(dec1 $(( d_cs / 10 )))"
	printf '"cpu":%s,"mem":%s,' "$(dec1 "$cpu10")" "$(dec1 "$mem10")"
	printf '"mem_used_kb":%s,"mem_total_kb":%s,' "$(( mem_total - mem_avail ))" "$mem_total"
	emit_temp cpu_tctl "$CPU_TCTL"
	emit_temp cpu_tccd "$CPU_TCCD"
	emit_temp vrm "$MB_VRM"
	emit_temp chipset "$MB_CHIP"
	emit_temp board "$MB_BOARD"
	nvme_max=null
	for t in $NVME_TEMPS; do
		if v=$(rd "$t"); then
			v=$(( v / 100 ))
			case $nvme_max in
				null) nvme_max=$v ;;
				*) [ "$v" -gt "$nvme_max" ] && nvme_max=$v ;;
			esac
		fi
	done
	case $nvme_max in
		null) printf '"nvme":null,' ;;
		*) printf '"nvme":%s,' "$(dec1 "$nvme_max")" ;;
	esac
	if [ -n "$MB_FAN" ] && v=$(rd "$MB_FAN"); then printf '"fan_rpm":%s,' "$v"; else printf '"fan_rpm":null,'; fi
	printf '"cpu_w":%s,' "$cpu_w"
	printf '"rx_bps":%s,"tx_bps":%s,' "$(( d_rx * 100 / d_cs ))" "$(( d_tx * 100 / d_cs ))"
	printf '"rd_bps":%s,"wr_bps":%s,' "$(( d_rd * 512 * 100 / d_cs ))" "$(( d_wr * 512 * 100 / d_cs ))"
	printf '"psi_cpu":%s,"psi_io":%s,"psi_mem":%s' "$psi_cpu" "$psi_io" "$psi_mem"
	printf '}\n'

	[ "$ONCE" = 1 ] && break
	sleep "$INTERVAL"
done
