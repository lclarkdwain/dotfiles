 /* wallust template - colors-rofi */

* {
active-background: #636E72;
active-foreground: #F8D4C7;
normal-background: #2C2C2D;
normal-foreground: #F8D4C7;
urgent-background: #7C8C91;
urgent-foreground: #F8D4C7;

alternate-active-background: #6A4740;
alternate-active-foreground: #F8D4C7;
alternate-normal-background: #2C2C2D;
alternate-normal-foreground: #F8D4C7;
alternate-urgent-background: #2C2C2D;
alternate-urgent-foreground: #F8D4C7;

selected-active-background: #636E72;
selected-active-foreground: #2C2C2D;
selected-normal-background: #636E72;
selected-normal-foreground: #2C2C2D;
selected-urgent-background: #6A4740;
selected-urgent-foreground: #2C2C2D;

background-color: #2C2C2D;
background: rgba(0,0,0,0.7);
foreground: #F8D4C7;
border-color: #636E72;

color0: #515151;
color1: #212123;
color2: #252527;
color3: #4F3530;
color4: #4A5256;
color5: #5D696D;
color6: #B16448;
color7: #EDBAA7;
color8: #A68275;
color9: #2C2C2E;
color10: #313234;
color11: #6A4740;
color12: #636E72;
color13: #7C8C91;
color14: #EC8560;
color15: #EDBAA7;


}

