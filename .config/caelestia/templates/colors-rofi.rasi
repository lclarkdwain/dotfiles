/* caelestia user template - rendered to ~/.local/state/caelestia/theme/ on every scheme change.
   User templates use {{ name.format }}; the {{ $name }} form is for caelestia's own templates. */

* {
    active-background: #{{ primary.hex }};
    active-foreground: #{{ onPrimary.hex }};
    normal-background: #{{ surface.hex }};
    normal-foreground: #{{ onSurface.hex }};
    urgent-background: #{{ error.hex }};
    urgent-foreground: #{{ onError.hex }};

    alternate-active-background: #{{ primaryContainer.hex }};
    alternate-active-foreground: #{{ onPrimaryContainer.hex }};
    alternate-normal-background: #{{ surfaceContainer.hex }};
    alternate-normal-foreground: #{{ onSurface.hex }};
    alternate-urgent-background: #{{ errorContainer.hex }};
    alternate-urgent-foreground: #{{ onErrorContainer.hex }};

    selected-active-background: #{{ primary.hex }};
    selected-active-foreground: #{{ onPrimary.hex }};
    selected-normal-background: #{{ secondaryContainer.hex }};
    selected-normal-foreground: #{{ onSecondaryContainer.hex }};
    selected-urgent-background: #{{ error.hex }};
    selected-urgent-foreground: #{{ onError.hex }};

    background-color: #{{ surface.hex }};
    /* b3 keeps the translucency the wallust file had via rgba(...,0.7) */
    background: #{{ surface.hex }}b3;
    foreground: #{{ onSurface.hex }};
    border-color: #{{ outline.hex }};

    /* saint-rofi.rasi and friends resolve active/urgent/selected from these. */
    color0: #{{ term0.hex }};
    color1: #{{ term1.hex }};
    color2: #{{ term2.hex }};
    color3: #{{ term3.hex }};
    color4: #{{ term4.hex }};
    color5: #{{ term5.hex }};
    color6: #{{ term6.hex }};
    color7: #{{ term7.hex }};
    color8: #{{ term8.hex }};
    color9: #{{ term9.hex }};
    color10: #{{ term10.hex }};
    color11: #{{ term11.hex }};
    color12: #{{ term12.hex }};
    color13: #{{ term13.hex }};
    color14: #{{ term14.hex }};
    color15: #{{ term15.hex }};
}
