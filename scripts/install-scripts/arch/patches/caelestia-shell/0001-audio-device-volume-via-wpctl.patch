Set device-backed sink/source volume with wpctl as well as through Quickshell, which
drops route volume writes when a route has no volumeStep (e.g. Bluetooth outputs
without AVRCP absolute volume). Upstream: Quickshell #807, fix in PR #808; drop this
patch once quickshell-git includes it.

diff --git a/services/Audio.qml b/services/Audio.qml
index c83d80ab..4caeb472 100644
--- a/services/Audio.qml
+++ b/services/Audio.qml
@@ -33,8 +33,10 @@ Singleton {
 
     function setVolume(newVolume: real): void {
         if (sink?.ready && sink?.audio) {
+            const clamped = Math.max(0, Math.min(GlobalConfig.services.maxVolume, newVolume));
             sink.audio.muted = false;
-            sink.audio.volume = Math.max(0, Math.min(GlobalConfig.services.maxVolume, newVolume));
+            sink.audio.volume = clamped;
+            root.setDeviceVolume(sink, clamped);
         }
     }
 
@@ -48,8 +50,10 @@ Singleton {
 
     function setSourceVolume(newVolume: real): void {
         if (source?.ready && source?.audio) {
+            const clamped = Math.max(0, Math.min(GlobalConfig.services.maxVolume, newVolume));
             source.audio.muted = false;
-            source.audio.volume = Math.max(0, Math.min(GlobalConfig.services.maxVolume, newVolume));
+            source.audio.volume = clamped;
+            root.setDeviceVolume(source, clamped);
         }
     }
 
@@ -167,6 +171,31 @@ Singleton {
         target: Pipewire.nodes
     }
 
+    // LOCAL FIX: Quickshell drops route volume writes when a route has no volumeStep
+    // (e.g. Bluetooth), so device-backed nodes are also set with wpctl (Quickshell #807).
+    property var pendingDeviceVolumes: ({})
+
+    function setDeviceVolume(node: PwNode, volume: real): void {
+        if (node?.properties?.["card.profile.device"] === undefined)
+            return;
+
+        pendingDeviceVolumes[node.id] = volume;
+        if (!deviceVolumeTimer.running)
+            deviceVolumeTimer.start();
+    }
+
+    Timer {
+        id: deviceVolumeTimer
+
+        interval: 50
+
+        onTriggered: {
+            for (const id in root.pendingDeviceVolumes)
+                Quickshell.execDetached(["wpctl", "set-volume", id, root.pendingDeviceVolumes[id].toFixed(4)]);
+            root.pendingDeviceVolumes = {};
+        }
+    }
+
     // Always track the current defaults so volume/mute bind even if the lists
     // momentarily lag behind the default node.
     PwObjectTracker {
