Set device-backed sink/source volume with wpctl as well as through Quickshell.

Quickshell (since upstream 522d126) only writes a device node's volume through its
route when the route reports a volumeStep. PipeWire's bluez5 module emits volumeStep
only while the transport's hardware (AVRCP absolute) volume is active, so for many
Bluetooth outputs the slider moved but the volume never changed, until a wpctl
keybind changed the route and Quickshell resynced.

Upstream: Quickshell issue #807 (also #857), fixed by PR #808, which was still unmerged
on 2026-09-13 (https://github.com/quickshell-mirror/quickshell/pull/808).

Applied on top of the shell clone by install-caelestia.sh. Drop it once the installed
quickshell-git includes PR #808.

diff --git a/services/Audio.qml b/services/Audio.qml
index c83d80ab..fffa2a16 100644
--- a/services/Audio.qml
+++ b/services/Audio.qml
@@ -33,8 +33,10 @@ Singleton {
 
     function setVolume(newVolume: real): void {
         if (sink?.ready && sink?.audio) {
+            const clamped = Math.max(0, Math.min(GlobalConfig.services.maxVolume, newVolume));
             sink.audio.muted = false;
-            sink.audio.volume = Math.max(0, Math.min(GlobalConfig.services.maxVolume, newVolume));
+            sink.audio.volume = clamped;
+            root.setDeviceVolume(sink, clamped);
         }
     }
 
@@ -48,8 +50,10 @@ Singleton {
 
     function setSourceVolume(newVolume: real): void {
         if (source?.ready && source?.audio) {
+            const clamped = Math.max(0, Math.min(GlobalConfig.services.maxVolume, newVolume));
             source.audio.muted = false;
-            source.audio.volume = Math.max(0, Math.min(GlobalConfig.services.maxVolume, newVolume));
+            source.audio.volume = clamped;
+            root.setDeviceVolume(source, clamped);
         }
     }
 
@@ -167,6 +171,36 @@ Singleton {
         target: Pipewire.nodes
     }
 
+    // LOCAL FIX: Quickshell only writes a device-backed node's volume through its route
+    // when the route reports a volumeStep (node.cpp, PwNodeBoundAudio::setVolumes).
+    // Bluetooth routes report none, so the write was dropped silently: the slider moved
+    // while the sink kept its volume, until a wpctl keybind changed the route and
+    // Quickshell resynced. Device-backed nodes are therefore also set with wpctl, the
+    // path the volume keys use. The native write above is kept so the slider follows a
+    // drag at once; writes are coalesced so a drag does not spawn a process per step.
+    property var pendingDeviceVolumes: ({})
+
+    function setDeviceVolume(node: PwNode, volume: real): void {
+        if (node?.properties?.["card.profile.device"] === undefined)
+            return;
+
+        pendingDeviceVolumes[node.id] = volume;
+        if (!deviceVolumeTimer.running)
+            deviceVolumeTimer.start();
+    }
+
+    Timer {
+        id: deviceVolumeTimer
+
+        interval: 50
+
+        onTriggered: {
+            for (const id in root.pendingDeviceVolumes)
+                Quickshell.execDetached(["wpctl", "set-volume", id, root.pendingDeviceVolumes[id].toFixed(4)]);
+            root.pendingDeviceVolumes = {};
+        }
+    }
+
     // Always track the current defaults so volume/mute bind even if the lists
     // momentarily lag behind the default node.
     PwObjectTracker {
