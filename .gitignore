.DS_Store
.zsh_plugins.zsh
logs

GTK-themes-icons

# ~/.local/bin is a symlink into this repo, so the Claude Code installer writes its
# launcher symlink here. Tracking it committed an absolute, user-specific path
# pinned to one version (/home/<user>/.local/share/claude/versions/X.Y.Z), which
# churned on every update and would resolve to nothing on another machine.
.local/bin/claude

claude/.claude-personal/.credentials.json
claude/.claude-personal/.claude.json
claude/.claude-personal/settings.json

.config/zsh/.zshrc.d/*.local.zsh
.config/caelestia/hypr.local.lua
.config/git/config.local

# Generated by caelestia
.config/btop/themes/caelestia.theme
.config/hypr/scheme/current.lua
.config/cava/config
.config/caelestia/monitors/
.config/zed/themes/
.config/spicetify/Themes/caelestia/color.ini

# Generated by nwg-displays; not loaded, monitors are set in caelestia/hypr-user.lua
.config/hypr/monitors.conf
.config/hypr/monitors.lua
.config/hypr/workspaces.conf

# App runtime state
.config/Thunar/accels.scm
.config/micro/*
!.config/micro/settings.json
.config/spicetify/*
!.config/spicetify/Themes/

# caelestia shell clone (its own git repo)
.config/quickshell/caelestia/
