.DS_Store
.config/tmux/plugins
.zsh_plugins.zsh
logs

GTK-themes-icons

# ~/.local/bin is a symlink into this repo, so the Claude Code installer writes its
# launcher symlink here. Tracking it committed an absolute, user-specific path
# pinned to one version (/home/<user>/.local/share/claude/versions/X.Y.Z), which
# churned on every update and would resolve to nothing on another machine.
.local/bin/claude

claude/.claude-personal/.credentials.json
claude/.claude-personal/.claude.json
claude/.claude-personal/settings.json

.config/zsh/.zshrc.d/*.local.zsh

# Rewritten by the wallpaper scripts on every change, pointing at an absolute
# path under ~/Pictures. Runtime state, not config.
.config/rofi/.current_wallpaper*
# Per-monitor copies of the current wallpaper, written by WallpaperSelect.sh.
.config/hypr/wallpaper_effects/.wallpaper_current_*

# Written by caelestia's Material You pipeline into dirs that stow links into this
# repo. Generated output, not config; regenerated on every scheme change.
.config/btop/themes/caelestia.theme
.config/hypr/scheme/
# Rewritten by caelestia on every scheme change; it owns colour now and waybar's
# cava module (the only consumer) is retired.
.config/cava/config
